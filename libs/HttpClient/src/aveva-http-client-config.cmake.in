set(AVEVA_HTTP_CLIENT_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(boost_asio REQUIRED)
find_dependency(boost_beast REQUIRED)
find_dependency(boost_url REQUIRED)
find_dependency(boost_unordered REQUIRED)
find_dependency(OpenSSL REQUIRED)

include(${CMAKE_CURRENT_LIST_DIR}/aveva-http-client-targets.cmake)

check_required_components(aveva-http-client)