{
  "version": 6,
  "configurePresets": [
    {
      "name": "_RootConfig",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AVEVA_AZURE_CLIENT_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_VISIBILITY_PRESET": "hidden",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": {
          "type": "STRING",
          "value": "${sourceDir}/infrastructure/cmake"
        },
        "VCPKG_MANIFEST_FEATURES": "tests;benchmarks",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/infrastructure/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/infrastructure/overlay-ports",
        "AVEVA_AZURE_CLIENT_TESTS": "ON",
        "AVEVA_AZURE_CLIENT_BENCHMARKS": "ON",
        "AVEVA_AZURE_CLIENT_RUN_INTEGRATION_TESTS": "ON"
      }
    },
    {
      "name": "_DebugBase",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "_ReleaseBase",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "_LinuxBase",
      "hidden": true,
      "inherits": [
        "_RootConfig"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "_WindowsBase",
      "hidden": true,
      "inherits": [
        "_RootConfig"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "_WindowsAsanBase",
      "hidden": true,
      "inherits": [
        "_RootConfig"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-asan",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md-asan"
      }
    },
    {
      "name": "WindowsDebug",
      "displayName": "MSVC Debug Build",
      "inherits": [
        "_DebugBase",
        "_WindowsBase"
      ],
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "OFF",
        "CMAKE_CXX_FLAGS": "/guard:cf /sdl /EHsc /GF /D_MSVC_STL_HARDENING=1 /Od /Zi /D_ITERATOR_DEBUG_LEVEL=2 /D_WIN32_WINNT=0x0A00"
      }
    },
    {
      "name": "WindowsDebugLlvm",
      "displayName": "LLVM/clang-cl Debug Build (clang-tidy always on)",
      "description": "Builds with clang-cl via the Ninja generator so CXX_CLANG_TIDY actually runs clang-tidy on every compile; the Visual Studio generator's ClangCL toolset does not honor CXX_CLANG_TIDY.",
      "inherits": [
        "_DebugBase",
        "_WindowsBase"
      ],
      "generator": "Ninja",
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "OFF",
        "AVEVA_AZURE_CLIENT_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_FLAGS": "/EHsc /D_MSVC_STL_HARDENING=1 /Od /Zi /D_ITERATOR_DEBUG_LEVEL=2 /D_WIN32_WINNT=0x0A00"
      }
    },
    {
      "name": "WindowsRelease",
      "displayName": "MSVC Release Build",
      "inherits": [
        "_ReleaseBase",
        "_WindowsBase"
      ],
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "OFF",
        "CMAKE_CXX_FLAGS": "/guard:cf /sdl /EHsc /GF /D_MSVC_STL_HARDENING=1 /O2 /D_WIN32_WINNT=0x0A00"
      }
    },
    {
      "name": "LinuxDebug",
      "displayName": "Linux Debug Build",
      "inherits": [
        "_DebugBase",
        "_LinuxBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O0 -g"
      }
    },
    {
      "name": "LinuxDebugLlvm",
      "displayName": "LLVM/clang Debug Build (clang-tidy always on)",
      "description": "Builds with clang so CXX_CLANG_TIDY runs clang-tidy on every compile, rather than clang-tidy being an opt-in, manually-invoked step.",
      "inherits": [
        "_DebugBase",
        "_LinuxBase"
      ],
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_CLANG_TIDY": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O0 -g"
      }
    },
    {
      "name": "LinuxRelease",
      "displayName": "Linux Release Build",
      "inherits": [
        "_ReleaseBase",
        "_LinuxBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O2 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3"
      }
    },
    {
      "name": "_ASanBase",
      "hidden": true,
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "LinuxDebugASan",
      "displayName": "Linux Debug Build with Address Sanitizer",
      "inherits": [
        "_DebugBase",
        "_LinuxBase",
        "_ASanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O0 -g"
      }
    },
    {
      "name": "LinuxReleaseASan",
      "displayName": "Linux Release Build with Address Sanitizer",
      "inherits": [
        "_ReleaseBase",
        "_LinuxBase",
        "_ASanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O1 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3"
      }
    },
    {
      "name": "WindowsDebugASan",
      "displayName": "MSVC Debug Build with Address Sanitizer",
      "inherits": [
        "_DebugBase",
        "_WindowsAsanBase",
        "_ASanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/guard:cf /sdl /EHsc /GF /D_MSVC_STL_HARDENING=1 /Od /Zi /D_ITERATOR_DEBUG_LEVEL=2 /D_WIN32_WINNT=0x0A00"
      }
    },
    {
      "name": "WindowsReleaseASan",
      "displayName": "MSVC Release Build with Address Sanitizer",
      "inherits": [
        "_ReleaseBase",
        "_WindowsAsanBase",
        "_ASanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/guard:cf /sdl /EHsc /GF /D_MSVC_STL_HARDENING=1 /O2 /D_WIN32_WINNT=0x0A00"
      }
    },
    {
      "name": "_UBSanBase",
      "hidden": true,
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_UBSAN": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "LinuxDebugUBSan",
      "displayName": "Linux Debug Build with Undefined Behavior Sanitizer",
      "inherits": [
        "_DebugBase",
        "_LinuxBase",
        "_UBSanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O0 -g"
      }
    },
    {
      "name": "_TSanBase",
      "hidden": true,
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_TSAN": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    },
    {
      "name": "LinuxDebugTSan",
      "displayName": "Linux Debug Build with Thread Sanitizer",
      "inherits": [
        "_DebugBase",
        "_LinuxBase",
        "_TSanBase"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -O1 -g"
      }
    },
    {
      "name": "_CIBase",
      "hidden": true,
      "description": "Shared pipeline overrides. CI presets build into the agent's binaries directory instead of the in-tree build folder. AVEVA_AZURE_CLIENT_TESTS comes from AVEVA_AZURE_CLIENT_WITH_TESTS and evaluates to OFF when that variable is unset, so pipelines/scripts/build.ps1 always sets it explicitly.",
      "cacheVariables": {
        "ENABLE_MULTI_THREADED_COMPILATION": "TRUE",
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "OFF",
        "AVEVA_AZURE_CLIENT_ENABLE_UBSAN": "OFF",
        "AVEVA_AZURE_CLIENT_TESTS": {
          "type": "BOOL",
          "value": "$env{AVEVA_AZURE_CLIENT_WITH_TESTS}"
        },
        "AVEVA_AZURE_CLIENT_BENCHMARKS": "ON",
        "AVEVA_AZURE_CLIENT_RUN_INTEGRATION_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "$env{AVEVA_AZURE_CLIENT_VCPKG_FEATURES}"
        },
        "AVEVA_AZURE_CLIENT_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "_CCacheBase",
      "hidden": true,
      "description": "ccache configuration for the self-hosted Linux build agents, which keep a persistent cache directory across runs. CCACHE_DIR must stay in sync with the _CCacheBuildBase build preset below and with CCacheBaseLinuxDirectory in pipelines/templates/shared-variables.yml, which the pipeline cache tasks use.",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      },
      "environment": {
        "CCACHE_DIR": "/home/imadmin/ccache",
        "CCACHE_LOGFILE": "/home/imadmin/ccache/ccache.log",
        "CCACHE_BASEDIR": "${sourceDir}/../.."
      }
    },
    {
      "name": "CIWindowsDebug",
      "displayName": "CI: MSVC Debug Build",
      "inherits": [
        "_CIBase",
        "WindowsDebug"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/WindowsDebug"
    },
    {
      "name": "CIWindowsRelease",
      "displayName": "CI: MSVC Release Build",
      "inherits": [
        "_CIBase",
        "WindowsRelease"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/WindowsRelease"
    },
    {
      "name": "CILinuxDebug",
      "displayName": "CI: Linux Debug Build",
      "description": "AVEVA_HTTP_CLIENT_LINK_JOBS is 1 because the Debug test executables each statically link the coverage-instrumented core archive. Concurrent links peak at several GB of RSS apiece and have repeatedly killed the hosted Linux agent during the final link phase, which surfaces as 'We stopped hearing from agent' rather than a build error. Compilation parallelism is unaffected and still comes from CMAKE_BUILD_PARALLEL_LEVEL in pipelines/scripts/build.ps1.",
      "inherits": [
        "_CIBase",
        "LinuxDebug"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/LinuxDebug",
      "cacheVariables": {
        "AVEVA_HTTP_CLIENT_LINK_JOBS": "1"
      }
    },
    {
      "name": "CILinuxRelease",
      "displayName": "CI: Linux Release Build",
      "inherits": [
        "_CIBase",
        "LinuxRelease"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/LinuxRelease"
    },
    {
      "name": "CILinuxDebugCCache",
      "displayName": "CI: Linux Debug Build (ccache)",
      "inherits": [
        "_CCacheBase",
        "CILinuxDebug"
      ]
    },
    {
      "name": "CILinuxReleaseCCache",
      "displayName": "CI: Linux Release Build (ccache)",
      "inherits": [
        "_CCacheBase",
        "CILinuxRelease"
      ]
    },
    {
      "name": "CILinuxDebugASan",
      "displayName": "CI: Linux Debug Build with Address Sanitizer",
      "description": "_CIBase is inherited first (so it wins) and switches every sanitizer off; re-enable this one explicitly.",
      "inherits": [
        "_CIBase",
        "LinuxDebugASan"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/LinuxDebugASan",
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "CILinuxDebugUBSan",
      "displayName": "CI: Linux Debug Build with Undefined Behavior Sanitizer",
      "description": "_CIBase is inherited first (so it wins) and switches every sanitizer off; re-enable this one explicitly.",
      "inherits": [
        "_CIBase",
        "LinuxDebugUBSan"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/LinuxDebugUBSan",
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "CILinuxDebugTSan",
      "displayName": "CI: Linux Debug Build with Thread Sanitizer",
      "description": "_CIBase is inherited first (so it wins) and switches every sanitizer off; re-enable this one explicitly.",
      "inherits": [
        "_CIBase",
        "LinuxDebugTSan"
      ],
      "binaryDir": "$env{BUILD_BINARIESDIRECTORY}/LinuxDebugTSan",
      "cacheVariables": {
        "AVEVA_AZURE_CLIENT_ENABLE_TSAN": "ON"
      }
    }
  ],
