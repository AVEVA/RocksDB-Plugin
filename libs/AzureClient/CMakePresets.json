    {
      "name": "_CCacheBuildBase",
      "hidden": true,
      "description": "ccache reads its configuration from the environment at compile time, so the build step needs the same values as the configure step. Keep these in sync with the _CCacheBase configure preset and with CCacheBaseLinuxDirectory in pipelines/templates/shared-variables.yml.",
      "environment": {
        "CCACHE_DIR": "/home/imadmin/ccache",
        "CCACHE_LOGFILE": "/home/imadmin/ccache/ccache.log",
