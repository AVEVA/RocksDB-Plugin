set(AVEVA_HTTP_CLIENT_VERSION @AVEVA_HTTP_CLIENT_PACKAGE_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Private dependencies: a static library still exports them as $<LINK_ONLY:...> link items.
find_dependency(OpenSSL REQUIRED)
find_dependency(boost_asio CONFIG REQUIRED)
find_dependency(boost_beast CONFIG REQUIRED)
find_dependency(boost_intrusive CONFIG REQUIRED)
find_dependency(boost_unordered CONFIG REQUIRED)
find_dependency(boost_url CONFIG REQUIRED)

include(${CMAKE_CURRENT_LIST_DIR}/aveva-http-client-targets.cmake)

check_required_components(aveva-http-client)
